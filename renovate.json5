{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>maxexcloo/dotfiles//renovate/default.json5"],
  // npm packages are bundled into the committed dist/, which must be rebuilt by hand.
  lockFileMaintenance: { automerge: false },
  packageRules: [{ automerge: false, matchManagers: ["npm"] }],
}
